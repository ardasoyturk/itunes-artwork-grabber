{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": "dist/_worker.js/index.js",
    "name": "itunes-artwork-grabber",
    "compatibility_date": "2026-02-16",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public",
    ],
    "assets": {
        "directory": "dist",
        "binding": "ASSETS",
    },
}
