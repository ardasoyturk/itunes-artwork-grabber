    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.64.0"
